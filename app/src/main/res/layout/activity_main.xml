<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/rounded_card"
            android:padding="24dp"
            android:elevation="5dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="AI STUDY PLANNER"
                android:textSize="27sp"
                android:textStyle="bold"
                android:textColor="#1A237E"
                android:gravity="center"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Your smart companion for better learning"
                android:textSize="15sp"
                android:textColor="#666666"
                android:gravity="center"
                android:layout_marginTop="8dp"/>

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="What would you like to do?"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#222222"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="14dp"/>

        <Button
            android:id="@+id/btnAddSubject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="＋  Add Subject"
            android:textSize="17sp"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:background="@drawable/rounded_button"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnAddTask"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="＋  Create Study Task"
            android:textSize="17sp"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:background="@drawable/rounded_button"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnViewTasks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="▣  View My Tasks"
            android:textSize="17sp"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:background="@drawable/rounded_button"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="◉  Study Progress"
            android:textSize="17sp"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:background="@drawable/rounded_button"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnAISuggestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✦  AI Study Suggestion"
            android:textSize="17sp"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:background="@drawable/rounded_button"
            android:layout_marginBottom="25dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/rounded_card"
            android:padding="20dp"
            android:elevation="3dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Study smarter. Stay consistent. 🚀"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#3949AB"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Plan • Practice • Progress"
                android:textSize="14sp"
                android:textColor="#777777"
                android:layout_marginTop="6dp"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>